# Variables d'environnement requises — copier dans .env.local et remplir les valeurs

# Supabase (instance self-hosted)
SUPABASE_URL=https://your-supabase-url.com
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_STUDIO_SERVICE_KEY=your_service_role_key_here

# Base de données Prisma
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Dashboard admin
DASHBOARD_PASSWORD=your_secure_password_here
DASHBOARD_TOKEN_SECRET=your_hmac_secret_at_least_32_chars_here

# Application
APP_ORIGIN=https://your-domain.com
ALLOWED_EMAIL=you@example.com

# IPs/hostnames privés autorisés pour webhooks, Ollama, Coolify et n8n (séparés par virgule)
TRUSTED_PRIVATE_HOSTS=192.168.0.14,192.168.0.19,n8n.kenomi.eu

# Autonomie agents — kill switch global et dry-run
AUTONOMY_ENABLED=true
AUTONOMY_DRY_RUN=false
AUTONOMY_GLOBAL_BUDGET_CAP_EUR=100

# Orchestrateur cron (optionnel — pour déclenchement automatique des agents)
AGENT_ORCHESTRATOR_SECRET=your_random_secret_here
AGENT_ORCHESTRATOR_USER_ID=uuid_du_user_proprietaire_des_schedules

# Health check — passer à false si une dépendance est volontairement optionnelle
HEALTH_DATABASE_REQUIRED=true
HEALTH_SUPABASE_REQUIRED=true
HEALTH_STORAGE_REQUIRED=true

# Prometheus metrics — protéger l'endpoint /api/metrics par bearer token
# (si non défini, l'endpoint est ouvert — OK en réseau privé seulement)
METRICS_TOKEN=

# Logger
LOG_LEVEL=info

# Stripe (mode test ou live selon l'env)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Coolify API
COOLIFY_URL=http://192.168.0.19:8000
COOLIFY_TOKEN=your_coolify_token_here
SOURCE_COMMIT=local-dev
EXPECTED_SOURCE_COMMIT=

# n8n adapter marketing (publication automatique live)
MARKETING_ADAPTER=n8n
N8N_PUBLISH_WEBHOOK_URL=https://n8n.kenomi.eu/webhook/publish
N8N_PUBLISH_TOKEN=your_shared_secret_here

# n8n adapter fulfillment (livraison post-paiement)
FULFILLMENT_WEBHOOK_URL=https://n8n.kenomi.eu/webhook/fulfill
FULFILLMENT_WEBHOOK_TOKEN=your_shared_secret_here

# n8n adapter nurture (relance post-waitlist)
NURTURE_WEBHOOK_URL=https://n8n.kenomi.eu/webhook/nurture
NURTURE_WEBHOOK_TOKEN=your_shared_secret_here
