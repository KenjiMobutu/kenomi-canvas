# Variables d'environnement requises — copier dans .env.local et remplir les valeurs

# Supabase (instance self-hosted)
SUPABASE_URL=https://your-supabase-url.com
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_STUDIO_SERVICE_KEY=your_service_role_key_here

# Base de données Prisma
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Dashboard admin
DASHBOARD_PASSWORD=your_secure_password_here
DASHBOARD_TOKEN_SECRET=your_hmac_secret_at_least_32_chars_here

# Application
APP_ORIGIN=https://your-domain.com
ALLOWED_EMAIL=you@example.com

# IPs/hostnames privés autorisés pour webhooks et Ollama (séparés par virgule)
TRUSTED_PRIVATE_HOSTS=192.168.0.14,192.168.0.19
